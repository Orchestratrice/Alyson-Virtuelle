filters:
  and:
    - file.inFolder("Alyson Directrice Principale/Centrale Alyson")
    - file.ext == "md"
views:
  - type: list
    name: List
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.mtime
  - type: cards
    name: Cards
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.mtime
    image: note.aliases
