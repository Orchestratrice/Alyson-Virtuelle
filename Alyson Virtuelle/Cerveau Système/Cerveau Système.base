filters:
  and:
    - file.inFolder("Cerveau Système")
    - file.ext == "md"
views:
  - type: list
    name: List
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.mtime
  - type: cards
    name: Cards
    order:
      - file.name
      - file.mtime
    imageAspectRatio: 0.5
    cardSize: 150
  - type: cards
    name: Vue
