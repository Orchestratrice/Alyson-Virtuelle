{
  "version": 1,
  "styling": true,
  "blank": false,
  "customSchema": {
    "schemaVersion": 2,
    "typeField": "type",
    "reserved": [
      "excalidraw-plugin",
      "kanban-plugin",
      "cssclasses",
      "aliases",
      "banner",
      "banner_x",
      "highlighter",
      "lineNumbers",
      "transition",
      "theme",
      "css",
      "drawings"
    ],
    "rules": [
      {
        "id": "review-needs-agent",
        "match": "all",
        "when": [
          {
            "field": "author",
            "in": [
              "agent",
              "mixed"
            ]
          }
        ],
        "then": [
          {
            "field": "review",
            "effect": "available"
          }
        ]
      },
      {
        "id": "reviewed-needs-review",
        "match": "all",
        "when": [
          {
            "field": "review",
            "in": [
              "reviewed",
              "changed"
            ]
          }
        ],
        "then": [
          {
            "field": "reviewed",
            "effect": "available"
          }
        ]
      },
      {
        "id": "status-for-brief",
        "match": "all",
        "when": [
          {
            "field": "type",
            "in": [
              "brief"
            ]
          }
        ],
        "then": [
          {
            "field": "status",
            "effect": "values",
            "values": [
              {
                "value": "planned",
                "color": "orange"
              },
              {
                "value": "active",
                "color": "green"
              },
              {
                "value": "paused",
                "color": "orange"
              },
              {
                "value": "done",
                "color": "green"
              }
            ]
          }
        ]
      },
      {
        "id": "status-for-solution",
        "match": "all",
        "when": [
          {
            "field": "type",
            "in": [
              "solution"
            ]
          }
        ],
        "then": [
          {
            "field": "status",
            "effect": "values",
            "values": [
              {
                "value": "draft",
                "color": "orange"
              },
              {
                "value": "stable",
                "color": "green"
              },
              {
                "value": "superseded",
                "color": "neutral"
              }
            ]
          }
        ]
      },
      {
        "id": "status-for-task",
        "match": "all",
        "when": [
          {
            "field": "type",
            "in": [
              "task"
            ]
          }
        ],
        "then": [
          {
            "field": "status",
            "effect": "values",
            "values": [
              {
                "value": "todo",
                "color": "purple"
              },
              {
                "value": "doing",
                "color": "blue"
              },
              {
                "value": "blocked",
                "color": "red"
              },
              {
                "value": "done",
                "color": "green"
              }
            ]
          }
        ]
      },
      {
        "id": "status-for-decision",
        "match": "all",
        "when": [
          {
            "field": "type",
            "in": [
              "decision"
            ]
          }
        ],
        "then": [
          {
            "field": "status",
            "effect": "values",
            "values": [
              {
                "value": "proposed",
                "color": "orange"
              },
              {
                "value": "accepted",
                "color": "green"
              },
              {
                "value": "superseded",
                "color": "neutral"
              }
            ]
          }
        ]
      },
      {
        "id": "status-for-output",
        "match": "all",
        "when": [
          {
            "field": "type",
            "in": [
              "output"
            ]
          }
        ],
        "then": [
          {
            "field": "status",
            "effect": "values",
            "values": [
              {
                "value": "draft",
                "color": "orange"
              },
              {
                "value": "final",
                "color": "green"
              },
              {
                "value": "superseded",
                "color": "neutral"
              }
            ]
          }
        ]
      }
    ],
    "fields": {
      "type": {
        "kind": "enum",
        "source": {
          "kind": "static",
          "values": [
            {
              "value": "capture",
